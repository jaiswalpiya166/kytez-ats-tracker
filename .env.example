# Database (Render sets this for you when you link the Postgres database)
DATABASE_URL=

# Session cookie secret: any long random string
SESSION_SECRET=

# First admin account (only used when the database has no admins yet)
ADMIN_EMAIL=admin@kytez.com.au
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Public site
PUBLIC_BASE_URL=https://kytez-ats.kytez.com.au
PUBLIC_API_ORIGINS=

# Email: used to send the employee application link when a candidate is moved to Hired.
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS = an app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kytez Recruitment <careers@kytez.com.au>"
MAIL_REPLY_TO=
